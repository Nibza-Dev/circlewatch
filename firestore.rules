rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /emailIndex/{email} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if false;
    }

    // Lets any authenticated user notify a specific person by uid,
    // without ever being able to read their profile.
    match /pushTokens/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /sessions/{sessionId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.uid in resource.data.circleUserIds);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
    }

    match /sosRecordings/{sosId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.uid in resource.data.circleUserIds);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
      allow delete: if false;

      match /segments/{segmentId} {
        allow read: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/sosRecordings/$(sosId)).data.ownerId ||
           request.auth.uid in get(/databases/$(database)/documents/sosRecordings/$(sosId)).data.circleUserIds);
        allow create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/sosRecordings/$(sosId)).data.ownerId;
        allow update, delete: if false;
      }

      // Photos captured during SOS (perpetrator, number plate, etc). Same
      // immutability rule as audio segments - once uploaded, evidence can't
      // be edited or deleted by anyone, including the person who took it.
      match /photos/{photoId} {
        allow read: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/sosRecordings/$(sosId)).data.ownerId ||
           request.auth.uid in get(/databases/$(database)/documents/sosRecordings/$(sosId)).data.circleUserIds);
        allow create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/sosRecordings/$(sosId)).data.ownerId;
        allow update, delete: if false;
      }
    }

    match /safetyFeed/{postId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
